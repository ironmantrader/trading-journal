rules_version = '2';

// กฎนี้เคยอยู่แต่ในหน้า Firebase console เท่านั้น — แก้ทีไรก็ไม่มีร่องรอยว่าใครแก้อะไร
// และวันที่กฎของ users/{uid} หายไป แอพก็เงียบไปเฉย ๆ โดยไม่มีอะไรบอก
// เก็บไว้ในรีโปแทน แล้ว deploy จากไฟล์นี้ทางเดียว
service cloud.firestore {
  match /databases/{database}/documents {

    // Trading Journal — เอกสารเดียวต่อผู้ใช้ อ่าน/เขียนได้เฉพาะเจ้าของ
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // สำเนารายวัน 7 ชุดล่าสุด — กฎของ document แม่ไม่ครอบ subcollection ต้องเขียนแยก
      match /backups/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // รูปตรวจการบ้านของอาจารย์ — doc ละรูป เพราะ doc เดียวเก็บได้ไม่เกิน 1 MiB
      match /coachShots/{shotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // รูปกราฟของแอพ gold-journal (คนละแอพ project เดียวกัน) — กฎชุดนี้ใช้ร่วมทั้ง project
      // deploy จากรีโปนี้ที่เดียวเท่านั้น ไม่งั้นกฎของอีกแอพจะหายไปเงียบ ๆ
      match /goldShots/{shotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Fitness Hub — คนละแอพ คนละ collection แต่ project เดียวกัน
    match /fitnessHub/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
